# ==============================================================================
# WANDERLUST / DESIGNESTHETICS TRAVEL APP CONFIGURATION
# ==============================================================================

# 1. Google Gemini AI API Key (For Live Conversational AI & Dynamic Itinerary Generation)
# Get your free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# 2. OpenWeatherMap API Key (For Live Meteorological Telemetry)
# Get your free key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# 3. Dynamic Image Sources (Unsplash, Pexels, or Cloudinary)
# Unsplash: https://unsplash.com/developers
# Pexels: https://www.pexels.com/api/
# Cloudinary: https://cloudinary.com/
VITE_UNSPLASH_ACCESS_KEY=
VITE_PEXELS_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=

# 4. Optional Cloudinary Hero Video URL (Self-hosted or Cloudinary stream)
# e.g., https://res.cloudinary.com/<your-cloud-name>/video/upload/f_auto,q_auto/hero-loop.mp4
VITE_CLOUDINARY_HERO_VIDEO_URL=
